# Адрес входа через «Центр-инвест». Пока пусто, кнопка на экране входа неактивна с пометкой «скоро».
# Когда бэкенд добавит вход через банк, впишите сюда его адрес и пересоберите фронт.
VITE_SSO_CENTRINVEST_URL=

# Только для Vite dev server. По умолчанию API доступен на http://127.0.0.1:8000.
# Для Docker адрес API задаётся конфигурацией nginx.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
