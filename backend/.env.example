# Скопируйте в .env и заполните. Файл .env в git не попадает.
CASHFLOW_ENV=dev
CASHFLOW_DATABASE_URL=sqlite:///./cashflow.db
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
CASHFLOW_JWT_SECRET=
CASHFLOW_DEMO_USER=demo
CASHFLOW_DEMO_PASSWORD=

# Сервисы-имитаторы (mocks/). Токен должен совпадать с MOCK_TOKEN имитатора.
CASHFLOW_ONEC_BASE_URL=http://localhost:8101
CASHFLOW_ONEC_TOKEN=
CASHFLOW_FNS_BASE_URL=http://localhost:8102
CASHFLOW_FNS_TOKEN=

# LLM (необязательно). Любой OpenAI-совместимый API: OpenAI, шлюз к YandexGPT/GigaChat, локальная модель.
CASHFLOW_LLM_PROVIDER=none
CASHFLOW_LLM_BASE_URL=https://routerai.ru/api/v1
CASHFLOW_LLM_MODEL=anthropic/claude-opus-5.5
CASHFLOW_LLM_MCP_ENABLED=true
CASHFLOW_LLM_API_KEY=

# Регистрация и вход без подтверждения почты. SMTP не нужен.
CASHFLOW_REQUIRE_EMAIL_VERIFICATION=false
# Подтверждение email. Docker по умолчанию использует Mailpit: http://localhost:8025.
# Для реальной отправки раскомментируйте и заполните настройки своего SMTP-провайдера.
# CASHFLOW_PUBLIC_APP_URL=https://your-app.example
# CASHFLOW_SMTP_HOST=smtp.your-provider.example
# CASHFLOW_SMTP_PORT=587
# CASHFLOW_SMTP_SECURITY=starttls
# CASHFLOW_SMTP_USER=
# CASHFLOW_SMTP_PASSWORD=
# CASHFLOW_SMTP_FROM=no-reply@your-domain.example
# CASHFLOW_VERIFICATION_TTL_MINUTES=60
# Для тестовой почты в dev: CASHFLOW_LOCAL_MAILBOX_URL=http://localhost:8025
# Для реальной доставки оставьте CASHFLOW_LOCAL_MAILBOX_URL пустым.
